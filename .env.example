# Ultimate Recon — API Key Configuration
# Copy this to .env and fill in your keys.
# Keys marked REQUIRED are needed by core tools; OPTIONAL expands coverage.
# Everything still works without API keys — only key-dependent tools are skipped.
#
# Usage:
#   cp .env.example .env    # then edit .env with your keys
#   python3 src/orchestrator.py example.com
#
# SECURITY: .env is in .gitignore — will NEVER be committed.

# === REQUIRED for key-dependent features (recommended) ===
# Get at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Get at: https://account.shodan.io/
SHODAN_API_KEY=

# Get at: https://developers.virustotal.com/
VIRUSTOTAL_API_KEY=

# Get at: https://chaos.projectdiscovery.io/
CHAOS_API_KEY=

# === OPTIONAL — extends coverage ===
# Get at: https://securitytrails.com/
SECURITYTRAILS_API_KEY=

# Get at: https://urlscan.io/
URLSCAN_API_KEY=

# Get at: https://hackertarget.com/
HACKERTARGET_API_KEY=

# Get at: https://otx.alienvault.com/
ALIENVAULT_API_KEY=

# Get at: https://bevigil.com/
BEVIGIL_API_KEY=

# Get at: https://www.zoomeye.org/
ZOOMEYE_API_KEY=

# Get at: https://developers.facebook.com/
FACEBOOK_API_KEY=
